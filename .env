# 公共环境变量
SERVER_COMMON_TITLE=这是公共标题

# mysql数据库连接地址，示例：DATABASE_URL="mysql://root:123456@localhost:3306/express_fullstack_db?connection_limit=20&pool_timeout=20"
# mysql数据库连接地址
# connection_limit=20: 最大连接数
# pool_timeout=20: 获取连接超时时间（秒）
# sslaccept=strict: SSL 连接配置
# socketTimeout=60000: 套接字超时时间
DATABASE_URL="mysql://root:123456@localhost:3306/express_fullstack_db?connection_limit=20&pool_timeout=20&socketTimeout=60000"

